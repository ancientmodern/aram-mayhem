class_name NavGrid
extends RefCounted
## Walkability + height grid on the XZ plane with A* pathfinding.
## Data comes from res://data/map/navgrid.json + navgrid_walk.bin + navgrid_height.bin
## (generated by tools/lol/extract_map_geo.py). Falls back to a procedural lane.

var origin := Vector2.ZERO      ## world XZ of cell (0,0) corner (x, z)
var cell := 0.5                 ## meters per cell
var w := 0
var h := 0
var walk := PackedByteArray()   ## 1 = walkable
var heights := PackedFloat32Array()
var astar := AStarGrid2D.new()
var brush := PackedByteArray()  ## brush region id per cell (0 = none)
## Ground height field units stand on (data/map/floor_height.bin, tools/lol/bake_floor_height.py): League's
## ngrid sampled-height node grid (~0.25 m) snapped to the rendered floor mesh. Node (0,0) is at floor_origin.
var floor_h := PackedFloat32Array()
var floor_origin := Vector2.ZERO
var floor_inv := Vector2.ONE    ## 1 / node spacing (x, z)
var floor_w := 0
var floor_hh := 0
var opened_cells := PackedInt32Array()   ## [path] cells of free-standing League navgrid slivers we open (see _open_islands)


func load_from(dir: String) -> bool:
	var meta_path := dir.path_join("navgrid.json")
	if not FileAccess.file_exists(meta_path):
		return false
	var meta: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(meta_path))
	origin = Vector2(meta.origin_x, meta.origin_z)
	cell = meta.cell
	w = int(meta.width)
	h = int(meta.height)
	walk = FileAccess.get_file_as_bytes(dir.path_join("navgrid_walk.bin"))
	var hb := FileAccess.get_file_as_bytes(dir.path_join("navgrid_height.bin"))
	heights = hb.to_float32_array()
	if FileAccess.file_exists(dir.path_join("navgrid_brush.bin")):
		brush = FileAccess.get_file_as_bytes(dir.path_join("navgrid_brush.bin"))
	if walk.size() != w * h or heights.size() != w * h:
		push_error("navgrid size mismatch")
		return false
	var fm = meta.get("floor")
	var fp := dir.path_join("floor_height.bin")
	if fm is Dictionary and FileAccess.file_exists(fp):
		var fb := FileAccess.get_file_as_bytes(fp).to_float32_array()
		if fb.size() == int(fm.width) * int(fm.height):
			floor_h = fb
			floor_w = int(fm.width)
			floor_hh = int(fm.height)
			floor_origin = Vector2(fm.origin_x, fm.origin_z)
			floor_inv = Vector2(1.0 / float(fm.dx), 1.0 / float(fm.dz))
			# per-cell heights (cell_center, debug draws) from the same field; the ngrid's own centerHeight is 0
			# on ~280 walkable cells, which used to lift units 1.8 m on those tiles
			for j in h:
				for i in w:
					heights[j * w + i] = height_at(Vector3(origin.x + (i + 0.5) * cell, 0.0, origin.y + (j + 0.5) * cell))
		else:
			push_error("floor_height.bin size mismatch")
	_open_islands()
	_build_astar()
	return true


## [path] League's Map12 navgrid has one free-standing unwalkable sliver (16 cells, flag 66, 4.5 m x 1 m) in the middle
## of the lane at (66.5..69.5, -61.2..-58.2), inside a patch of grass decoration with no collision mesh, prop or wall
## anywhere near it (nothing in the floor or the props marks it). In our game it was an invisible obstacle that made
## champions detour around the middle brush-looking patch. Every unwalkable connected component (8-neighbourhood)
## that is small (< ISLAND_MAX cells) and does not touch the grid border is such an island: open it.
const ISLAND_MAX := 64


func _open_islands() -> void:
	var seen := PackedByteArray()
	seen.resize(w * h)
	opened_cells = PackedInt32Array()
	for k0 in w * h:
		if walk[k0] == 1 or seen[k0] == 1:
			continue
		var comp := PackedInt32Array()
		var stack := PackedInt32Array([k0])
		seen[k0] = 1
		var border := false
		var big := false
		while not stack.is_empty():
			var k: int = stack[stack.size() - 1]
			stack.resize(stack.size() - 1)
			if not big:
				comp.append(k)
				if comp.size() >= ISLAND_MAX:
					big = true
			var x := k % w
			var z := k / w
			if x == 0 or z == 0 or x == w - 1 or z == h - 1:
				border = true
			for dz in range(-1, 2):
				for dx in range(-1, 2):
					var nx := x + dx
					var nz := z + dz
					if nx < 0 or nz < 0 or nx >= w or nz >= h:
						continue
					var nk := nz * w + nx
					if walk[nk] == 0 and seen[nk] == 0:
						seen[nk] = 1
						stack.append(nk)
		if not big and not border:
			for k in comp:
				walk[k] = 1
			opened_cells.append_array(comp)


## Procedural fallback: walkable corridor around a polyline (world points).
func build_corridor(points: Array, half_width: float, circles: Array) -> void:
	var minx := INF
	var maxx := -INF
	var minz := INF
	var maxz := -INF
	for p in points + circles.map(func(c): return c[0]):
		minx = minf(minx, p.x)
		maxx = maxf(maxx, p.x)
		minz = minf(minz, p.z)
		maxz = maxf(maxz, p.z)
	var pad := half_width + 15.0
	origin = Vector2(minx - pad, minz - pad)
	w = int(ceil((maxx - minx + pad * 2) / cell))
	h = int(ceil((maxz - minz + pad * 2) / cell))
	walk.resize(w * h)
	heights.resize(w * h)
	heights.fill(0.0)
	for j in h:
		for i in w:
			var p := Vector3(origin.x + (i + 0.5) * cell, 0.0, origin.y + (j + 0.5) * cell)
			var ok := false
			for k in points.size() - 1:
				if _dist_to_segment(p, points[k], points[k + 1]) <= half_width:
					ok = true
					break
			if not ok:
				for c in circles:
					if G.flat_dist(p, c[0]) <= c[1]:
						ok = true
						break
			walk[j * w + i] = 1 if ok else 0
	_build_astar()


static func _dist_to_segment(p: Vector3, a: Vector3, b: Vector3) -> float:
	var ab := Vector2(b.x - a.x, b.z - a.z)
	var ap := Vector2(p.x - a.x, p.z - a.z)
	var t := clampf(ap.dot(ab) / maxf(ab.length_squared(), 0.0001), 0.0, 1.0)
	return (ap - ab * t).length()


func _build_astar() -> void:
	astar = AStarGrid2D.new()
	astar.region = Rect2i(0, 0, w, h)
	astar.cell_size = Vector2(1, 1)
	astar.diagonal_mode = AStarGrid2D.DIAGONAL_MODE_ONLY_IF_NO_OBSTACLES
	astar.default_compute_heuristic = AStarGrid2D.HEURISTIC_OCTILE
	astar.default_estimate_heuristic = AStarGrid2D.HEURISTIC_OCTILE
	astar.jumping_enabled = false
	astar.update()
	for j in h:
		for i in w:
			if walk[j * w + i] == 0:
				astar.set_point_solid(Vector2i(i, j), true)


## Mark a disc as blocked (structures). Call after load.
func block_disc(center: Vector3, r: float) -> void:
	var c := to_cell(center)
	var rc := int(ceil(r / cell))
	for j in range(c.y - rc, c.y + rc + 1):
		for i in range(c.x - rc, c.x + rc + 1):
			if i < 0 or j < 0 or i >= w or j >= h:
				continue
			var p := cell_center(Vector2i(i, j))
			if G.flat_dist(p, center) <= r:
				walk[j * w + i] = 0
				astar.set_point_solid(Vector2i(i, j), true)


func unblock_disc(center: Vector3, r: float, original: PackedByteArray) -> void:
	var c := to_cell(center)
	var rc := int(ceil(r / cell))
	for j in range(c.y - rc, c.y + rc + 1):
		for i in range(c.x - rc, c.x + rc + 1):
			if i < 0 or j < 0 or i >= w or j >= h:
				continue
			var idx := j * w + i
			if original[idx] == 1:
				walk[idx] = 1
				astar.set_point_solid(Vector2i(i, j), false)


func to_cell(p: Vector3) -> Vector2i:
	return Vector2i(int(floor((p.x - origin.x) / cell)), int(floor((p.z - origin.y) / cell)))


func cell_center(c: Vector2i) -> Vector3:
	var x := origin.x + (c.x + 0.5) * cell
	var z := origin.y + (c.y + 0.5) * cell
	return Vector3(x, _h(c.x, c.y), z)


func in_bounds(c: Vector2i) -> bool:
	return c.x >= 0 and c.y >= 0 and c.x < w and c.y < h


func _h(i: int, j: int) -> float:
	if i < 0 or j < 0 or i >= w or j >= h:
		return 0.0
	return heights[j * w + i]


func is_walkable(p: Vector3) -> bool:
	var c := to_cell(p)
	return in_bounds(c) and walk[c.y * w + c.x] == 1


func brush_id(p: Vector3) -> int:
	if brush.is_empty():
		return 0
	var c := to_cell(p)
	if not in_bounds(c):
		return 0
	return brush[c.y * w + c.x]


## Bilinear terrain height (hot path: ~70 units per frame).
func height_at(p: Vector3) -> float:
	if floor_w > 0:
		var gx := clampf((p.x - floor_origin.x) * floor_inv.x, 0.0, floor_w - 1.001)
		var gz := clampf((p.z - floor_origin.y) * floor_inv.y, 0.0, floor_hh - 1.001)
		var fi := int(gx)
		var fj := int(gz)
		var ux := gx - fi
		var uz := gz - fj
		var k := fj * floor_w + fi
		var h0 := floor_h[k] + (floor_h[k + 1] - floor_h[k]) * ux
		var h1 := floor_h[k + floor_w] + (floor_h[k + floor_w + 1] - floor_h[k + floor_w]) * ux
		return h0 + (h1 - h0) * uz
	if w == 0:
		return 0.0
	var fx := (p.x - origin.x) / cell - 0.5
	var fz := (p.z - origin.y) / cell - 0.5
	var i := int(floor(fx))
	var j := int(floor(fz))
	var tx := fx - i
	var tz := fz - j
	var a := _h(i, j)
	var b := _h(i + 1, j)
	var c := _h(i, j + 1)
	var d := _h(i + 1, j + 1)
	return lerpf(lerpf(a, b, tx), lerpf(c, d, tx), tz)


## [path] Where a click on terrain you cannot stand on sends the unit: among the walkable cells within 1.5 m of the
## closest one to the click, the one nearest to the unit. The plain nearest cell can sit on the far side of a wall or
## a structure's disc and made the champion walk all the way around to it.
func reach_point(click: Vector3, from: Vector3) -> Vector3:
	var p0 := nearest_walkable(click)
	var d0 := G.flat_dist(p0, click)
	var rc := int(ceil((d0 + 1.5) / cell))
	var c := to_cell(click)
	var best := p0
	var bd := INF
	for j in range(c.y - rc, c.y + rc + 1):
		for i in range(c.x - rc, c.x + rc + 1):
			if i < 0 or j < 0 or i >= w or j >= h or walk[j * w + i] == 0:
				continue
			var q := cell_center(Vector2i(i, j))
			if G.flat_dist(q, click) > d0 + 1.5:
				continue
			var d := G.flat_dist(q, from)
			if d < bd:
				bd = d
				best = q
	return best


func nearest_walkable(p: Vector3, max_r: int = 30) -> Vector3:
	if not p.is_finite():
		return Vector3.ZERO
	var c := to_cell(p)
	if in_bounds(c) and walk[c.y * w + c.x] == 1:
		return p
	for r in range(1, max_r):
		var best := Vector2i(-1, -1)
		var bd := INF
		for j in range(c.y - r, c.y + r + 1):
			for i in range(c.x - r, c.x + r + 1):
				if absi(i - c.x) != r and absi(j - c.y) != r:
					continue
				if not in_bounds(Vector2i(i, j)) or walk[j * w + i] == 0:
					continue
				var d := Vector2(i - c.x, j - c.y).length_squared()
				if d < bd:
					bd = d
					best = Vector2i(i, j)
		if best.x >= 0:
			return cell_center(best)
	return p


## True if the straight segment a->b stays on walkable cells.
func line_walkable(a: Vector3, b: Vector3) -> bool:
	if not a.is_finite() or not b.is_finite():
		return false
	var d := minf(G.flat_dist(a, b), 400.0)
	var steps := int(ceil(d / (cell * 0.5)))
	for s in range(steps + 1):
		var t := float(s) / maxf(steps, 1)
		if not is_walkable(a.lerp(b, t)):
			return false
	return true


## Furthest walkable point along a->b (for dashes into walls). If `b` is walkable but the
## path crosses a thin wall, dashing over it is allowed (League lets dashes cross walls).
func clamp_walkable(a: Vector3, b: Vector3) -> Vector3:
	if not b.is_finite():
		G.bad_vector("clamp_walkable", b)
		return a
	if is_walkable(b):
		return b
	var d := minf(G.flat_dist(a, b), 400.0)
	var steps := int(ceil(d / (cell * 0.5)))
	var last := a
	for s in range(steps + 1):
		var t := float(s) / maxf(steps, 1)
		var p := a.lerp(b, t)
		if is_walkable(p):
			last = p
	return last


func find_path(from: Vector3, to: Vector3) -> PackedVector3Array:
	var out := PackedVector3Array()
	if not from.is_finite() or not to.is_finite():
		G.bad_vector("find_path", to)
		return out
	if w == 0:
		out.append(to)
		return out
	var goal := to
	if not is_walkable(goal):
		goal = reach_point(to, from)
	var start := from
	if not is_walkable(start):
		start = nearest_walkable(start)
	if line_walkable(start, goal):
		out.append(goal)
		return out
	var cs := to_cell(start)
	var cg := to_cell(goal)
	if not in_bounds(cs) or not in_bounds(cg):
		out.append(goal)
		return out
	var ids := astar.get_id_path(cs, cg, true)
	if ids.is_empty():
		out.append(goal)
		return out
	var pts: Array = []
	for c in ids:
		pts.append(cell_center(c))
	pts[pts.size() - 1] = goal
	# string pulling: greedy line-of-sight smoothing
	var cur := start
	var k := 0
	while k < pts.size():
		var far := k
		var n := pts.size()
		var j := n - 1
		while j > k:
			if line_walkable(cur, pts[j]):
				far = j
				break
			j -= 1
		out.append(pts[far])
		cur = pts[far]
		k = far + 1
	return out
