; Engine configuration file.
; ARAM: Mayhem - single-player Howling Abyss recreation.

config_version=5

[application]

config/name="ARAM: Mayhem"
config/description="Single-lane 5v5 with randomized augments."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/ui/icon.png"
run/max_fps=0
boot_splash/bg_color=Color(0.03, 0.04, 0.07, 1)
boot_splash/show_image=false

[autoload]

G="*res://src/autoload/game.gd"
Sfx="*res://src/autoload/sfx.gd"

[debug]

gdscript/warnings/inference_on_variant=1
gdscript/warnings/unused_variable=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/return_value_discarded=0
gdscript/warnings/unused_signal=0
gdscript/warnings/confusable_local_declaration=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0

[rendering]

renderer/rendering_method="forward_plus"
limits/global_shader_variables/buffer_size=262144
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.09, 1)
textures/vram_compression/import_etc2_astc=false

[shader_globals]

gamma_out={
"type": "float",
"value": 0.0
}
lightgrid={
"type": "sampler2D",
"value": ""
}
lightgrid_on={
"type": "float",
"value": 0.0
}
